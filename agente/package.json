{
  "name": "zyntra-agente",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Agente de impressao do ZYNTRA. Roda na maquina da bancada, ligada por USB na Zebra ZD220.",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node agente.mjs",
    "impressoras": "node -e \"import('node:child_process').then(c=>c.execSync(process.platform==='win32'?'wmic printer get name':'lpstat -p',{stdio:'inherit'}))\""
  }
}
