# Normalmente você NÃO precisa deste arquivo.
#
# O agente pergunta o e-mail e a senha na primeira vez e guarda a credencial
# da máquina em ~/.zyntra/agente.json sozinho. Estas variáveis existem só para
# instalações fora do padrão.

# Outro projeto Supabase (ex.: ambiente de teste).
# ZYNTRA_URL=https://xxxx.supabase.co
# ZYNTRA_CHAVE=sb_publishable_...

# Guardar a credencial em outro lugar.
# ZYNTRA_CONFIG=/caminho/para/agente.json
